# Compose-level configuration reference.
#
# This file is NOT loaded automatically. It documents the knobs docker-compose.yml
# reads, and every one of them has a working default, so the stack comes up from a
# clean clone with no configuration at all:
#
#     docker compose up --build
#
# To change one, either export it for a single run
#
#     ENDPOINT_MOCK=0 docker compose up
#
# or add it to the repo-root .env, which Compose reads for variable substitution
# automatically. That is the recommended place, because it is already gitignored
# and already the project's configuration file.
#
#   ENDPOINT_MOCK=0
#
# The ENDPOINT_ prefix is not decoration. The repo's .env already sets
# S1_URL=http://localhost:8001 for host development, and Compose reads .env for
# substitution -- so reusing the bare names would feed the host's localhost URLs
# into the containers, where they point each service at itself. The prefixed
# names cannot collide with the host-development ones. S1_URL/S2_URL/S3_URL are
# the exception: they are hardcoded in docker-compose.yml to the compose service
# names and deliberately cannot be overridden. See the header of that file for
# what happens when they are wrong.
#
# ---------------------------------------------------------------------------

# --- data mode ---
# 1 replays the committed fixtures in services/*/fixtures/ and never touches the
# network. It replaces the HTTP transport and nothing else: the same parse,
# geometry and ranking code runs either way, so a mock run is a real run with a
# different transport.
#
# The default is 1 because it is the only default that makes a first `up`
# reliable. Live mode depends on Overpass, which 504s often enough to matter, and
# on the cache being warm.
#
# For 0, run `make prefetch` first. Then expect S1's 3-second budget to be tight
# on a cold cache: ENDPOINT.md section 4.5 gives S1 three seconds precisely
# because it must serve from cache, and a cold Overpass query is slower than that.
ENDPOINT_MOCK=1

# --- demo area ---
# south,west,north,east. FIU Miami, the Ernest R. Graham Center.
#
# The box is chosen for cover density (427 building passages, 100 covered
# walkways, 31 shelters, against 2 covered ways in the Brickell box ENDPOINT.md
# used as its example).
ENDPOINT_DEMO_BBOX=25.7533,-80.3762,25.7605,-80.3682

# Where the demo rider stands, and a separate decision from the box. Picked by
# scanning 20 positions in the box for the one whose five best legal kerbs sit
# closest to overhead cover, because that -- not the box's raw cover count -- is
# what decides whether rain mode has anything to rank. At the Graham Center
# entrance the best kerb was 47.2 m from any cover and rain mode found cover for
# zero of 30 spots; here the best is 5.8 m and the mean over the best five is
# 12 m. See shared/config.py::demo_rider.
ENDPOINT_DEMO_RIDER=25.7584,-80.3725

# IANA zone. Solar position uses local standard time, and Miami is UTC-5 in
# winter, so hardcoding an offset would shift the sun by an hour across the DST
# boundary -- enough to move a shadow off a kerb and fail the sun side-flip demo
# for the wrong reason.
ENDPOINT_DEMO_TZ=America/New_York

# "right" for right-hand traffic (US, and the Miami demo area). Decides which kerb
# is offered on a one-way street.
ENDPOINT_TRAFFIC_SIDE=right

# --- ports on the host ---
# The internal container ports are fixed by ENDPOINT.md section 8 and are not
# configurable: s1 8001, s2 8002, orchestrator 8000, nginx 8080. Only the host
# side moves, which is what you want when something else already owns 8000.
#
# The frontend default of 5500 matches scripts/run_all.sh, so nothing that worked
# on the host changes meaning.
ENDPOINT_ORCHESTRATOR_PORT=8000
ENDPOINT_FRONTEND_PORT=5500

# --- demo hygiene ---
# S1 exposes GET /spots/explain, a development tool that shows every candidate
# and why it was kept or dropped, with the underlying OSM source ids. Set this to
# 1 to remove it from the public surface before a demo.
ENDPOINT_STRIP_DEV_ROUTES=0
