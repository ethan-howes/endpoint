# Orchestrator URL (the backend's orchestrator/main.py).
VITE_API_URL=http://localhost:8000
# 1 = run without a backend, on in-browser placeholder data. 0 (default) = use the orchestrator.
VITE_USE_PLACEHOLDER=0
# Optional: key for a browser-side sun shadow layer (ShadeMap). Not wired yet; see ShadeLayer in MapView.tsx.
VITE_SHADEMAP_KEY=
