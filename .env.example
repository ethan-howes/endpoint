# Copy to `.env` and edit. NEVER commit `.env`.

# --- demo mode ---
# MOCK=1 serves from the committed fixtures in services/*/fixtures/ and never
# touches the network. Parsing, geometry and ranking run the same code either
# way, so a mock run is a real run with a different transport.
MOCK=0

# Demo area: south,west,north,east.
# FIU Miami, the Ernest R. Graham Center. Cover density in this box is high
# (427 `tunnel=building_passage`, 100 `covered=yes` ways, versus 2 `covered`
# ways in the Brickell box ENDPOINT.md used as its example), which is why it is
# the box. The *rider* position below is a separate, measured choice: see
# DEMO_RIDER and shared/config.py::demo_rider.
DEMO_BBOX=25.7533,-80.3762,25.7605,-80.3682

# Where the demo rider stands. Picked by scanning 20 positions in the box for
# the one whose five best legal kerbs sit closest to overhead cover, because that
# — not the box's raw cover count — is what decides whether rain mode has
# anything to rank. At the Graham Center entrance the best kerb was 47 m from
# any cover; here it is 5.8 m, and the mean over the best five is 12 m.
DEMO_RIDER=25.7584,-80.3725

# IANA time zone of the demo area. Solar API shade uses local standard time.
DEMO_TZ=America/New_York

# --- API keys ---
ANTHROPIC_API_KEY=
# Solar API (shade). Optional: Street View, Routes, Places.
# S2 does NOT need this: it models sun/shade from OSM building and tree
# geometry via pvlib, and reports which method produced each answer in
# `shade_source`. Setting the key buys accuracy, not function.
GOOGLE_MAPS_API_KEY=
MAPILLARY_TOKEN=

# --- routing ---
# osrm | google
ROUTER=osrm

# --- service URLs used by the orchestrator (ENDPOINT.md section 8) ---
S1_URL=http://localhost:8001
S2_URL=http://localhost:8002
S3_URL=http://localhost:8003

# --- traffic side ---
# Which side of a two-way road vehicles travel on. "right" for the US (and the
# Miami demo area). This decides which kerb is offered on a one-way street.
TRAFFIC_SIDE=right

# --- demo hygiene ---
# Set to 1 to remove S1's dev-only /spots/explain route from the public surface.
STRIP_DEV_ROUTES=0

# --- S2 demo forcing ---
# Never cut these: the rain scenario is the one ENDPOINT.md's §6 definition of
# done is written around, and it is also the scenario Miami weather will not
# cooperate with on a demo day. Forcing is a *request* parameter
# (`force_condition=rain`, `force_time=<iso8601>`), not a global, so a normal ride
# still reads live weather and only a deliberate demo is overridden.
#
# A forced condition never fabricates numbers. `overridden_weather` omits the
# forecast entirely and sets `source=demo_override`, `overridden=true`, so a
# recorded run is always distinguishable from a real one in the response and in
# the rider-facing message.
#
# `force_time` is what makes §6's sun demo work: 14:00Z casts shadows WNW and
# 20:00Z casts them ENE, so the same street recommends opposite kerbs.
#   rain:        force_condition=rain
#   sun, 10:00:  force_condition=sun  force_time=<today>T14:00:00Z
#   sun, 16:00:  force_condition=sun  force_time=<today>T20:00:00Z
